{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25
    },
    "configurePresets": [
        {
            "name": "desktop-debug",
            "displayName": "Desktop (Debug)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/desktop.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORM": "Desktop",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.25"
            }
        },
        {
            "name": "desktop-release",
            "displayName": "Desktop (Release)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/desktop.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORM": "Desktop",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.25"
            }
        },
        {
            "name": "ios",
            "hidden": true,
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/ios.cmake",
            "cacheVariables": {
                "PLATFORM": "iOS",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.25"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "ios-debug",
            "displayName": "iOS Device (Debug)",
            "inherits": "ios",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_OSX_SYSROOT": "iphoneos"
            }
        },
        {
            "name": "ios-release",
            "displayName": "iOS Device (Release)",
            "inherits": "ios",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_SYSROOT": "iphoneos"
            }
        },
        {
            "name": "ios-simulator-debug",
            "displayName": "iOS Simulator (Debug)",
            "inherits": "ios",
            "cacheVariables": {
                "PLATFORM": "iOS-Simulator",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_OSX_SYSROOT": "iphonesimulator"
            }
        },
        {
            "name": "ios-simulator-release",
            "displayName": "iOS Simulator (Release)",
            "inherits": "ios",
            "cacheVariables": {
                "PLATFORM": "iOS-Simulator",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_SYSROOT": "iphonesimulator"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "desktop-debug",
            "configurePreset": "desktop-debug"
        },
        {
            "name": "desktop-release",
            "configurePreset": "desktop-release"
        },
        {
            "name": "ios",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "ios-debug",
            "inherits": "ios",
            "configurePreset": "ios-debug",
            "configuration": "Debug",
            "nativeToolOptions": ["-allowProvisioningUpdates"]
        },
        {
            "name": "ios-release",
            "inherits": "ios",
            "configurePreset": "ios-release",
            "configuration": "Release",
            "nativeToolOptions": ["-allowProvisioningUpdates"]
        },
        {
            "name": "ios-simulator-debug",
            "inherits": "ios",
            "configurePreset": "ios-simulator-debug",
            "configuration": "Debug"
        },
        {
            "name": "ios-simulator-release",
            "inherits": "ios",
            "configurePreset": "ios-simulator-release",
            "configuration": "Release"
        }
    ]

}