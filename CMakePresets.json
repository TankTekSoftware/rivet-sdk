{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25
    },
    "configurePresets": [
        {
            "name": "platform",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_POLICY_VERSION_MINIMUM": "3.25"
            }
        },
        {
            "name": "desktop",
            "hidden": true,
            "inherits": "platform",
            "generator": "Ninja",
            "cacheVariables": {
                "PLATFORM": "Desktop"
            }
        },

        {
            "name": "windows",
            "hidden": true,
            "inherits": "desktop",
            "toolchainFile": "${sourceDir}/cmake/windows.cmake",
            "condition": {
                "type": "inList",
                "string": "${hostSystemName}",
                "list": ["Windows", "Linux"]
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows (Debug)",
            "inherits": "windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows (Release)",
            "inherits": "windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },

        {
            "name": "linux",
            "hidden": true,
            "inherits": "desktop",
            "toolchainFile": "${sourceDir}/cmake/linux.cmake",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux (Debug)",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux (Release)",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },

        {
            "name": "macos",
            "hidden": true,
            "inherits": "desktop",
            "toolchainFile": "${sourceDir}/cmake/macos.cmake",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS (Debug)",
            "inherits": "macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS (Release)",
            "inherits": "macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },

        {
            "name": "ios",
            "hidden": true,
            "inherits": "platform",
            "generator": "Xcode",
            "toolchainFile": "${sourceDir}/cmake/ios.cmake",
            "cacheVariables": {
                "PLATFORM": "iOS"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "ios-debug",
            "displayName": "iOS Device (Debug)",
            "inherits": "ios",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_OSX_SYSROOT": "iphoneos"
            }
        },
        {
            "name": "ios-release",
            "displayName": "iOS Device (Release)",
            "inherits": "ios",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_SYSROOT": "iphoneos"
            }
        },
        {
            "name": "ios-simulator-debug",
            "displayName": "iOS Simulator (Debug)",
            "inherits": "ios",
            "cacheVariables": {
                "PLATFORM": "iOS-Simulator",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_OSX_SYSROOT": "iphonesimulator"
            }
        },
        {
            "name": "ios-simulator-release",
            "displayName": "iOS Simulator (Release)",
            "inherits": "ios",
            "cacheVariables": {
                "PLATFORM": "iOS-Simulator",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_SYSROOT": "iphonesimulator"
            }
        },

        {
            "name": "android",
            "hidden": true,
            "inherits": "platform",
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/cmake/android.cmake",
            "cacheVariables": {
                "PLATFORM": "Android"
            }
        },
        {
            "name": "android-debug",
            "displayName": "Android Device (Debug)",
            "inherits": "android",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "android-release",
            "displayName": "Android Device (Release)",
            "inherits": "android",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "android-emulator-debug",
            "displayName": "Android Emulator (Debug)",
            "inherits": "android",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "RIVET_ANDROID_EMULATOR": "ON"
            }
        },
        {
            "name": "android-emulator-release",
            "displayName": "Android Emulator (Release)",
            "inherits": "android",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "RIVET_ANDROID_EMULATOR": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows",
            "hidden": true,
            "condition": {
                "type": "inList",
                "string": "${hostSystemName}",
                "list": ["Windows", "Linux"]
            }
        },
        {
            "name": "windows-debug",
            "inherits": "windows",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "inherits": "windows",
            "configurePreset": "windows-release"
        },

        {
            "name": "linux",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "linux",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "inherits": "linux",
            "configurePreset": "linux-release"
        },

        {
            "name": "macos",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-debug",
            "inherits": "macos",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "inherits": "macos",
            "configurePreset": "macos-release"
        },

        {
            "name": "ios",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "ios-debug",
            "inherits": "ios",
            "configurePreset": "ios-debug",
            "configuration": "Debug",
            "nativeToolOptions": ["-allowProvisioningUpdates"]
        },
        {
            "name": "ios-release",
            "inherits": "ios",
            "configurePreset": "ios-release",
            "configuration": "Release",
            "nativeToolOptions": ["-allowProvisioningUpdates"]
        },
        {
            "name": "ios-simulator-debug",
            "inherits": "ios",
            "configurePreset": "ios-simulator-debug",
            "configuration": "Debug"
        },
        {
            "name": "ios-simulator-release",
            "inherits": "ios",
            "configurePreset": "ios-simulator-release",
            "configuration": "Release"
        },

        {
            "name": "android-debug",
            "configurePreset": "android-debug"
        },
        {
            "name": "android-release",
            "configurePreset": "android-release"
        },
        {
            "name": "android-emulator-debug",
            "configurePreset": "android-emulator-debug"
        },
        {
            "name": "android-emulator-release",
            "configurePreset": "android-emulator-release"
        }
    ]
}
